{
    "name": "@aimdb/weather-mesh-client",
    "version": "3.0.0",
    "description": "Browser client for the AimDB weather mesh \u2014 typed readings over AimX, no keys to spell",
    "license": "Apache-2.0",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "pkg"
    ],
    "sideEffects": [
        "./pkg/*.js"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "typecheck": "tsc --noEmit",
        "test": "vitest run"
    },
    "devDependencies": {
        "typescript": "^5.6.0",
        "vitest": "^3.0.0"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    }
}
