+/// What a caller does about a [`DbError`]: retry, resubscribe, stop, or fix
+/// something — and which something.
+///
+/// [`DbError`] is `#[non_exhaustive]`, so a mapping written outside this crate
+/// needs a wildcard arm, and a variant added later lands in it silently. This
+/// is the classification such a mapping should match on instead. It follows the
+/// house style already set by [`RpcError`](crate::session::RpcError): small,
+/// action-shaped, and stable while the variants grow.
+///
+/// The invariant that makes it worth having: **kinds are actions, and actions
+/// do not multiply when variants do.** A new `DbError` variant is a compile
+/// error in [`DbError::kind`] — inside this crate, where someone can decide
+/// which existing action it belongs to — rather than a silent reclassification
+/// at every FFI boundary.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
+#[non_exhaustive]
+pub enum DbErrorKind {
+    /// Nothing available, or no room, *right now*. Retry.
+    ///
+    /// Not a failure so much as a state: a `try_` call that found an empty
+    /// buffer, or a bounded buffer with no space. The same call may succeed a
+    /// moment later.
+    Retry,
+
+    /// Values were dropped because this reader fell behind. Continue.
+    ///
+    /// Distinct from [`Retry`](Self::Retry) because the caller has lost data
+    /// and may want to say so, and distinct from an error because the next read
+    /// will succeed.
+    Lagged,
+
+    /// The database or buffer is shutting down. Stop.
+    ///
+    /// Terminal: retrying cannot help, and a caller looping on reads should
+    /// leave the loop.
+    Closed,
+
+    /// An I/O or connection failure. Retry, or fix the deployment.
+    Transport,
+
+    /// A payload could not be encoded or decoded. Fix the schema or the sender.
+    Data,
+
+    /// The record graph is misconfigured. Fix it before starting.
+    ///
+    /// Everything a `build()` refuses: a missing parameter, a cycle, a
+    /// transform wired to a record nobody registered.
+    Configuration,
+
+    /// This call was wrong for this record. Fix the call site.
+    ///
+    /// An unknown key, an id out of range, the wrong type for a record that
+    /// exists, an operation the caller is not allowed to perform.
+    Usage,
+
+    /// The database's own machinery or its host. Neither retrying nor fixing
+    /// the caller will help.
+    Internal,
+}
+
+impl DbError {
+    /// Classify the failure by what the caller can do about it.
+    ///
+    /// The match below is exhaustive *inside the crate that owns the enum*,
+    /// which is the whole point: a variant added later fails to compile here
+    /// instead of falling into a wildcard somewhere downstream.
+    pub fn kind(&self) -> DbErrorKind {
+        match self {
+            Self::BufferEmpty | Self::BufferFull { .. } => DbErrorKind::Retry,
+
+            Self::BufferLagged { .. } => DbErrorKind::Lagged,
+
+            Self::BufferClosed { .. } => DbErrorKind::Closed,
+
+            Self::ConnectionFailed { .. } => DbErrorKind::Transport,
+
+            Self::MissingConfiguration { .. }
+            | Self::InvalidConfiguration { .. }
+            | Self::CyclicDependency { .. }
+            | Self::TransformInputNotFound { .. } => DbErrorKind::Configuration,
+
+            Self::RecordNotFound { .. }
+            | Self::RecordKeyNotFound { .. }
+            | Self::InvalidRecordId { .. }
+            | Self::TypeMismatch { .. }
+            | Self::InvalidOperation { .. }
+            | Self::PermissionDenied { .. } => DbErrorKind::Usage,
+
+            Self::RuntimeError { .. } | Self::Internal { .. } => DbErrorKind::Internal,
+
+            #[cfg(feature = "std")]
+            Self::Io { .. } | Self::IoWithContext { .. } => DbErrorKind::Transport,
+
+            #[cfg(feature = "std")]
+            Self::Json { .. } | Self::JsonWithContext { .. } => DbErrorKind::Data,
+        }
+    }
+}
+
 /// Type alias for Results using DbError
 pub type DbResult<T> = Result<T, DbError>;
 
