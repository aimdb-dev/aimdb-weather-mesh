+impl SyncError {
+    /// Classify the failure by what the caller can do about it.
+    ///
+    /// Returns [`DbErrorKind`] rather than a kind of its own, so a caller —
+    /// an FFI layer above all — has *one* set of actions for the whole stack
+    /// instead of one per crate. The [`Db`](SyncError::Db) arm delegates, so a
+    /// buffer that is merely empty classifies the same whether it is reached
+    /// through this facade or through `aimdb-core` directly.
+    ///
+    /// Exhaustive inside the crate that owns the enum, for the reason
+    /// [`DbError::kind`] is.
+    pub fn kind(&self) -> DbErrorKind {
+        match self {
+            // The facade's own machinery failed to start or stop. Note that
+            // the *cause* may well have been a configuration mistake — the
+            // message says so — but `AttachFailed` carries a `String`, so the
+            // cause's own kind does not survive the trip. See the crate docs.
+            Self::AttachFailed { .. } | Self::DetachFailed { .. } => DbErrorKind::Internal,
+
+            // A bounded wait expired. The same call may succeed a moment later.
+            Self::SetTimeout | Self::GetTimeout => DbErrorKind::Retry,
+
+            // Terminal: the runtime thread is gone and will not come back.
+            Self::RuntimeShutdown => DbErrorKind::Closed,
+
+            Self::Db(err) => err.kind(),
+        }
+    }
+}
+
 /// Result alias for blocking-facade operations.
 pub type SyncResult<T> = Result<T, SyncError>;
